# Database Connection (Vanilla PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/replacement_desk

# Auth & Session Security (32-character random string)
AUTH_SECRET=tbc-kart-default-secure-auth-secret-key-min-32-chars
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=tbc-kart-default-secure-auth-secret-key-min-32-chars

# Local File Storage Directory (defaults to ./uploads locally, /app/uploads in Docker)
UPLOAD_DIR=./uploads

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Telegram Operational Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CUSTOMER_SUPPORT_CHAT_ID=
TELEGRAM_LOGISTICS_CHAT_ID=
TELEGRAM_PRINTING_CHAT_ID=
TELEGRAM_PACKING_CHAT_ID=
